{
  "buildCommand": "node scripts/apply-command-migration.mjs && node scripts/watermark-legacy-photos.mjs && npm run build",
  "crons": [
    { "path": "/api/cron/resident-correction-deliveries", "schedule": "0 0 * * *" },
    { "path": "/api/cron/backup-escalations", "schedule": "1 0 * * *" }
  ],
  "installCommand": "ONNXRUNTIME_NODE_INSTALL=skip npm install --include=optional",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ."
}
