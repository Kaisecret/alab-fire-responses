export const reportFireStyles = `
    /* ============================================================
       REPORT FIRE PAGE — Premium Redesign
       ============================================================ */
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap');

    :root {
        --rf-red:          #d31212;
        --rf-red-dark:     #b91c1c;
        --rf-red-light:    #fee2e2;
        --rf-red-glow:     rgba(211,18,18,0.18);
        --rf-text:         #0f172a;
        --rf-text-2:       #334155;
        --rf-text-muted:   #64748b;
        --rf-border:       #e2e8f0;
        --rf-border-soft:  #f1f5f9;
        --rf-bg:           #f8fafc;
        --rf-white:        #ffffff;
        --rf-card-shadow:  0 1px 3px rgba(15,23,42,0.06), 0 4px 16px rgba(15,23,42,0.07);
        --rf-card-shadow-hover: 0 4px 8px rgba(15,23,42,0.08), 0 12px 32px rgba(15,23,42,0.10);
        --rf-radius:       1rem;
        --rf-radius-sm:    0.6rem;
        --rf-radius-xs:    0.35rem;
        --rf-transition:   0.22s cubic-bezier(0.4,0,0.2,1);
        /* legacy aliases kept for leaflet compatibility */
        --primary-red: #d31212;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --card-bg: #f8fafc;
        --bg-white: #ffffff;
        --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    /* ── Reset (scoped) ── */
    .rf-root *, .rf-root *::before, .rf-root *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }
    .rf-root {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        background: var(--rf-bg);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* ── Emergency Warning Strip ── */
    .rf-emergency-bar {
        background: linear-gradient(90deg, #991b1b 0%, #b91c1c 50%, #991b1b 100%);
        color: #fff;
        text-align: center;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    .rf-emergency-bar svg { width: 0.9rem; height: 0.9rem; flex-shrink: 0; }

    /* ── Page Grid ── */
    .rf-page-grid {
        flex: 1;
        display: grid;
        grid-template-columns: 260px 1fr 272px;
        gap: 1.5rem;
        max-width: 1380px;
        width: 100%;
        margin: 2rem auto;
        padding: 0 1.5rem;
        align-items: start;
    }

    /* ── Card Base ── */
    .rf-card {
        background: var(--rf-white);
        border: 1px solid var(--rf-border);
        border-radius: var(--rf-radius);
        box-shadow: var(--rf-card-shadow);
        transition: box-shadow var(--rf-transition);
    }
    .rf-card:hover { box-shadow: var(--rf-card-shadow-hover); }

    /* ── Left Column ── */
    .rf-left { display: flex; flex-direction: column; gap: 1rem; }
    .rf-account-card { padding: 1.4rem; }
    .rf-card-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--rf-text-muted);
        margin-bottom: 0.9rem;
    }
    .rf-card-label svg { width: 1.1rem; height: 1.1rem; color: var(--rf-red); }
    .rf-account-pill {
        background: linear-gradient(135deg, #fff5f5 0%, #fef2f2 100%);
        border: 1px solid #fecaca;
        border-radius: var(--rf-radius-sm);
        padding: 0.9rem 1rem;
        margin-bottom: 0.9rem;
    }
    .rf-account-pill-title {
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--rf-red-dark);
        margin-bottom: 0.3rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .rf-account-pill-title svg { width: 0.9rem; height: 0.9rem; }
    .rf-account-pill p { font-size: 0.78rem; color: #7f1d1d; line-height: 1.5; opacity: 0.85; }
    .rf-assist-card { padding: 1.4rem; }
    .rf-assist-card p { font-size: 0.8rem; color: var(--rf-text-muted); line-height: 1.5; margin-bottom: 1rem; }
    .rf-btn-outline {
        display: flex; align-items: center; justify-content: center; gap: 0.4rem;
        width: 100%; padding: 0.75rem; border: 1.5px solid var(--rf-red);
        background: transparent; color: var(--rf-red); border-radius: var(--rf-radius-sm);
        font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all var(--rf-transition); font-family: inherit;
    }
    .rf-btn-outline:hover { background: var(--rf-red-light); box-shadow: 0 0 0 3px var(--rf-red-glow); }
    .rf-btn-outline svg { width: 0.9rem; height: 0.9rem; }

    /* ── Center Column ── */
    .rf-main { display: flex; flex-direction: column; gap: 0; }
    .rf-main-card { padding: 0; overflow: hidden; }
    .rf-form-hero { padding: 2rem 2rem 1.5rem; border-bottom: 1px solid var(--rf-border-soft); }
    .rf-form-title {
        font-size: 1.65rem; font-weight: 900; color: var(--rf-text);
        letter-spacing: -0.03em; margin-bottom: 1.2rem;
        display: flex; align-items: center; gap: 0.6rem;
    }
    .rf-form-title-icon {
        width: 2.2rem; height: 2.2rem;
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        border-radius: 0.6rem; display: grid; place-items: center; flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(211,18,18,0.3);
    }
    .rf-form-title-icon img { width: 1.35rem; height: 1.35rem; object-fit: contain; filter: brightness(0) invert(1); }
    .rf-fire-banner {
        display: flex; align-items: center; gap: 1rem;
        background: linear-gradient(135deg, #fff7f7 0%, #fff1f2 100%);
        border: 1px solid #fecaca; border-radius: var(--rf-radius-sm); padding: 1rem 1.2rem;
    }
    .rf-fire-banner-icon {
        width: 3rem; height: 3rem;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        border-radius: 0.6rem; display: grid; place-items: center; flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(220,38,38,0.25);
    }
    .rf-fire-banner-icon img { width: 1.8rem; height: 1.8rem; object-fit: contain; filter: brightness(0) invert(1); }
    .rf-fire-banner-copy h3 { font-size: 1rem; font-weight: 800; color: #991b1b; margin-bottom: 0.2rem; }
    .rf-fire-banner-copy p { font-size: 0.82rem; color: #7f1d1d; font-weight: 500; line-height: 1.4; }
    .rf-form-body { padding: 1.5rem 2rem 2rem; display: flex; flex-direction: column; gap: 1.75rem; }

    /* ── Step Headers ── */
    .rf-step-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; }
    .rf-step-label {
        display: flex; align-items: center; gap: 0.55rem;
        font-size: 0.78rem; font-weight: 800; letter-spacing: 0.07em;
        text-transform: uppercase; color: var(--rf-text-2);
    }
    .rf-step-num {
        width: 1.6rem; height: 1.6rem; background: var(--rf-red); color: #fff;
        border-radius: 50%; font-size: 0.75rem; font-weight: 800; display: grid; place-items: center;
        flex-shrink: 0; box-shadow: 0 2px 6px rgba(211,18,18,0.3);
    }

    /* ── Location Status Badge ── */
    .rf-loc-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.28rem 0.65rem; border-radius: 2rem;
        font-size: 0.64rem; font-weight: 800; letter-spacing: 0.05em;
        text-transform: uppercase; border: 1.5px solid;
        transition: color 0.2s, background-color 0.2s, border-color 0.2s;
    }
    .rf-loc-badge::before {
        content: ''; width: 0.45rem; height: 0.45rem;
        border-radius: 50%; background: currentColor; display: block; flex-shrink: 0;
    }
    .rf-loc-badge.is-locating,
    .rf-loc-badge.is-improving  { color: #c2410c; background: #fff7ed; border-color: #fed7aa; }
    .rf-loc-badge.is-confirmed,
    .rf-loc-badge.is-adjusted   { color: #15803d; background: #f0fdf4; border-color: #bbf7d0; }
    .rf-loc-badge.is-approximate,
    .rf-loc-badge.is-adjusting  { color: #b45309; background: #fffbeb; border-color: #fde68a; }
    .rf-loc-badge.is-low-accuracy,
    .rf-loc-badge.is-outside,
    .rf-loc-badge.is-error      { color: #b91c1c; background: #fef2f2; border-color: #fecaca; }

    /* ── Two-Col Grid ── */
    .rf-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    /* ── Location Card ── */
    .rf-loc-card {
        border: 1.5px solid var(--rf-border); border-radius: var(--rf-radius-sm);
        overflow: hidden; background: #ffffff; display: flex; flex-direction: column; position: relative;
        transition: border-color var(--rf-transition), box-shadow var(--rf-transition);
    }
    .rf-loc-card[data-location-state="confirmed"],
    .rf-loc-card[data-location-state="adjusted"]  { border-color: #86efac; box-shadow: 0 0 0 3px rgba(134,239,172,0.18); }
    .rf-loc-card[data-location-state="low-accuracy"],
    .rf-loc-card[data-location-state="error"],
    .rf-loc-card[data-location-state="outside"]   { border-color: #fca5a5; box-shadow: 0 0 0 3px rgba(252,165,165,0.18); }
    .rf-loc-info { padding: 0.9rem 1rem; display: flex; flex-direction: column; gap: 0; flex: 1; }
    .rf-loc-heading {
        display: flex; align-items: center; gap: 0.45rem;
        font-size: 0.88rem; font-weight: 800; color: var(--rf-text); margin-bottom: 0.6rem;
    }
    .rf-loc-heading svg { width: 1rem; height: 1rem; color: var(--rf-red); flex-shrink: 0; }
    .rf-loc-address {
        display: flex; flex-direction: column; gap: 0.28rem;
        margin-bottom: 0.55rem; padding: 0.65rem 0.75rem;
        background: #f8fafc; border: 1px solid var(--rf-border); border-radius: var(--rf-radius-xs);
    }
    .rf-loc-address-row {
        display: flex; align-items: flex-start; gap: 0.35rem;
        font-size: 0.73rem; color: var(--rf-text-2); line-height: 1.3;
    }
    .rf-loc-address-row svg { width: 0.82rem; height: 0.82rem; color: var(--rf-red); flex-shrink: 0; margin-top: 0.08rem; }
    .rf-loc-address-row strong { font-weight: 700; overflow-wrap: anywhere; }
    .rf-loc-sep { color: var(--rf-text-muted); font-weight: 600; }
    .rf-loc-error {
        display: block; margin-bottom: 0.5rem; padding: 0.5rem 0.65rem;
        background: #fef2f2; border: 1px solid #fecaca; border-left: 3px solid #dc2626;
        border-radius: var(--rf-radius-xs); font-size: 0.7rem; color: #991b1b;
        line-height: 1.4; font-weight: 500;
    }
    .rf-loc-accuracy {
        display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.2rem 0.5rem;
        border-radius: 0.25rem; background: #f1f5f9; color: #475569;
        font-size: 0.67rem; font-weight: 700; margin-bottom: 0.55rem;
    }
    .rf-loc-card[data-location-state="confirmed"] .rf-loc-accuracy,
    .rf-loc-card[data-location-state="adjusted"]  .rf-loc-accuracy  { color: #15803d; background: #dcfce7; }
    .rf-loc-card[data-location-state="approximate"] .rf-loc-accuracy { color: #92400e; background: #fef3c7; }

    /* Button Row */
    .rf-btn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
    .rf-btn-sm {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem;
        flex: 1 1 6rem; min-height: 2.1rem; padding: 0.4rem 0.6rem;
        border: 1.5px solid var(--rf-border); background: var(--rf-white); color: var(--rf-text-2);
        border-radius: var(--rf-radius-xs); font-size: 0.72rem; font-weight: 700;
        cursor: pointer; transition: all var(--rf-transition); font-family: inherit;
    }
    .rf-btn-sm:hover { border-color: var(--rf-red); color: var(--rf-red); background: #fff5f5; }
    .rf-btn-sm:disabled { opacity: 0.5; cursor: default; }
    .rf-btn-sm svg { width: 0.8rem; height: 0.8rem; flex-shrink: 0; }

    /* Map Surface */
    .rf-map-surface {
        width: 100%; height: 10.5rem; flex: 0 0 10.5rem;
        border-top: 1px solid var(--rf-border); position: relative;
        z-index: 0; isolation: isolate; overflow: hidden; background: #dbeafe;
    }
    .rf-map-inner,
    .rf-map-inner.leaflet-container {
        width: 100%; height: 100%; font-family: 'Plus Jakarta Sans', sans-serif; background: #dbeafe;
    }
    .rf-map-inner .leaflet-control-zoom { border: 0; border-radius: 0.4rem; overflow: hidden; box-shadow: 0 4px 12px rgba(15,23,42,0.18); }
    .rf-map-inner .leaflet-control-zoom a { width: 1.9rem; height: 1.9rem; line-height: 1.9rem; border: 0; color: #172033; background: rgba(255,255,255,0.96); }
    .rf-map-inner .leaflet-control-zoom a:hover { color: var(--rf-red); background: #fff; }
    .rf-map-inner .leaflet-control-attribution { max-width: 100%; padding: 0 0.15rem; font-size: 0.38rem; line-height: 1.1; }
    .rf-map-overlay {
        position: absolute; right: 0.5rem; bottom: 0.5rem; left: 0.5rem; z-index: 700;
        display: flex; align-items: center; justify-content: center; gap: 0.45rem;
        min-height: 2.2rem; padding: 0.4rem 0.7rem;
        background: rgba(255,255,255,0.94); border: 1px solid rgba(255,255,255,0.82);
        border-radius: 0.4rem; box-shadow: 0 4px 12px rgba(15,23,42,0.16);
        font-size: 0.65rem; font-weight: 800; color: var(--rf-red);
        pointer-events: none; transition: opacity 0.22s, visibility 0.22s;
    }
    .rf-map-overlay.is-hidden { opacity: 0; visibility: hidden; }
    .rf-map-pulse {
        width: 0.8rem; height: 0.8rem; border: 2px solid var(--rf-red);
        border-radius: 50%; flex-shrink: 0; animation: rf-pulse 1.35s ease-out infinite;
    }
    @keyframes rf-pulse {
        0%   { box-shadow: 0 0 0 0 rgba(211,18,18,0.45); transform: scale(0.85); }
        70%  { box-shadow: 0 0 0 0.75rem rgba(211,18,18,0); transform: scale(1); }
        100% { box-shadow: 0 0 0 0 rgba(211,18,18,0); transform: scale(0.85); }
    }
    .location-map-marker-wrapper { background: transparent; border: 0; }
    .location-map-marker {
        display: grid; place-items: center; width: 2.38rem; height: 2.38rem;
        border: 2px solid #fff; border-radius: 50%; background: var(--rf-red);
        box-shadow: 0 4px 10px rgba(15,23,42,0.34); overflow: hidden;
    }
    .location-map-marker img { width: 1.72rem; height: 1.72rem; object-fit: contain; filter: brightness(0) invert(1); }
    @media (prefers-reduced-motion: reduce) {
        .rf-map-pulse { animation: none; }
        .rf-map-overlay, .rf-loc-badge { transition: none; }
    }

    /* ── Landmark Card ── */
    .rf-landmark-card {
        border: 1.5px solid var(--rf-border); border-radius: var(--rf-radius-sm);
        overflow: hidden; background: #ffffff; padding: 1rem;
        display: flex; flex-direction: column; gap: 0.75rem; min-height: 12rem;
        transition: border-color var(--rf-transition);
    }
    .rf-landmark-card[data-landmark-state="confirmed"]   { border-color: #86efac; }
    .rf-landmark-card[data-landmark-state="unavailable"] { border-color: var(--rf-border); }
    .rf-landmark-top { display: flex; align-items: flex-start; gap: 0.75rem; }
    .rf-landmark-icon {
        width: 2.5rem; height: 2.5rem; border-radius: 0.5rem;
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        display: grid; place-items: center; flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(211,18,18,0.22); transition: background var(--rf-transition);
    }
    .rf-landmark-icon svg { width: 1.2rem; height: 1.2rem; color: #fff; }
    .rf-landmark-card[data-landmark-state="confirmed"]   .rf-landmark-icon { background: linear-gradient(135deg, #22c55e, #15803d); box-shadow: 0 4px 10px rgba(34,197,94,0.22); }
    .rf-landmark-card[data-landmark-state="unavailable"] .rf-landmark-icon { background: linear-gradient(135deg, #94a3b8, #64748b); box-shadow: none; }
    .rf-landmark-copy { min-width: 0; }
    .rf-landmark-status { display: block; font-size: 0.63rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--rf-text-muted); margin-bottom: 0.25rem; }
    .rf-landmark-name { font-size: 0.9rem; font-weight: 800; color: var(--rf-text); line-height: 1.35; overflow-wrap: anywhere; }
    .rf-landmark-hint { font-size: 0.74rem; color: var(--rf-text-muted); line-height: 1.45; }

    /* ── Fire Type Grid ── */
    .rf-type-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem; }
    .rf-type-btn {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 0.5rem; padding: 1rem 0.4rem; border: 1.5px solid var(--rf-border);
        border-radius: var(--rf-radius-sm); background: var(--rf-white); color: var(--rf-text-muted);
        font-size: 0.72rem; font-weight: 700; cursor: pointer; transition: all var(--rf-transition);
        text-align: center; font-family: inherit;
    }
    .rf-type-btn svg { width: 1.8rem; height: 1.8rem; color: var(--rf-text-muted); transition: color var(--rf-transition); }
    .rf-type-btn:hover { border-color: var(--rf-red); color: var(--rf-red); background: #fff5f5; box-shadow: 0 0 0 3px var(--rf-red-glow); }
    .rf-type-btn:hover svg { color: var(--rf-red); }
    .rf-type-btn.selected { border-color: var(--rf-red); color: var(--rf-red); background: linear-gradient(135deg, #fff5f5, #ffe4e6); box-shadow: 0 0 0 3px var(--rf-red-glow); }
    .rf-type-btn.selected svg { color: var(--rf-red); }

    /* ── Textarea + Photos ── */
    .rf-textarea {
        width: 100%; border: 1.5px solid var(--rf-border); border-radius: var(--rf-radius-sm);
        padding: 0.85rem 1rem; font-size: 0.875rem; font-family: inherit; color: var(--rf-text);
        resize: vertical; min-height: 90px; background: var(--rf-white);
        transition: border-color var(--rf-transition), box-shadow var(--rf-transition);
    }
    .rf-textarea::placeholder { color: #94a3b8; }
    .rf-textarea:focus { outline: none; border-color: var(--rf-red); box-shadow: 0 0 0 3px var(--rf-red-glow); }
    .rf-photo-row { display: flex; gap: 0.75rem; }
    .rf-photo-btn {
        flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.45rem;
        padding: 0.8rem; border: 1.5px dashed var(--rf-border); border-radius: var(--rf-radius-sm);
        background: #fafbfc; color: var(--rf-text-muted); font-size: 0.78rem; font-weight: 700;
        cursor: pointer; transition: all var(--rf-transition); font-family: inherit;
    }
    .rf-photo-btn svg { width: 1rem; height: 1rem; }
    .rf-photo-btn:hover { border-color: var(--rf-red); color: var(--rf-red); background: #fff5f5; border-style: solid; }
    .rf-optional-tag { font-size: 0.7rem; color: var(--rf-text-muted); font-weight: 500; margin-left: 0.3rem; text-transform: none; letter-spacing: 0; }

    /* ── Form Footer ── */
    .rf-form-footer {
        display: flex; gap: 0.75rem; padding: 1.25rem 2rem;
        border-top: 1px solid var(--rf-border-soft); background: #f8fafc;
    }
    .rf-btn-submit {
        flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.55rem;
        padding: 1rem 1.5rem; background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        color: #fff; border: none; border-radius: var(--rf-radius-sm);
        font-size: 1rem; font-weight: 800; cursor: pointer; transition: all var(--rf-transition);
        font-family: inherit; letter-spacing: 0.02em; box-shadow: 0 4px 16px rgba(211,18,18,0.3);
    }
    .rf-btn-submit:hover { background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); box-shadow: 0 6px 24px rgba(211,18,18,0.4); transform: translateY(-1px); }
    .rf-btn-submit:active { transform: translateY(0); }
    .rf-btn-submit svg { width: 1.1rem; height: 1.1rem; }
    .rf-btn-cancel {
        padding: 1rem 1.5rem; background: var(--rf-white); color: var(--rf-text-muted);
        border: 1.5px solid var(--rf-border); border-radius: var(--rf-radius-sm);
        font-size: 0.9rem; font-weight: 700; cursor: pointer; transition: all var(--rf-transition); font-family: inherit;
    }
    .rf-btn-cancel:hover { border-color: var(--rf-red); color: var(--rf-red); background: #fff5f5; }

    /* ── Right Column ── */
    .rf-right { display: flex; flex-direction: column; gap: 1rem; }
    .rf-safety-card { padding: 1.4rem; }
    .rf-safety-list { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
    .rf-safety-list li { display: flex; align-items: flex-start; gap: 0.55rem; font-size: 0.82rem; color: var(--rf-text-2); font-weight: 500; line-height: 1.4; }
    .rf-safety-dot { width: 0.5rem; height: 0.5rem; background: var(--rf-red); border-radius: 50%; flex-shrink: 0; margin-top: 0.32rem; }
    .rf-incident-card { padding: 1.4rem; }
    .rf-incident-alert {
        background: linear-gradient(135deg, #fff7ed, #fef3c7); border: 1px solid #fde68a;
        border-radius: var(--rf-radius-sm); padding: 0.75rem 0.9rem;
        display: flex; align-items: flex-start; gap: 0.55rem; margin-bottom: 1rem;
    }
    .rf-incident-alert svg { width: 1rem; height: 1rem; color: #d97706; flex-shrink: 0; margin-top: 0.05rem; }
    .rf-incident-alert p { font-size: 0.8rem; color: #92400e; font-weight: 500; line-height: 1.45; }
    .rf-btn-outline-sm {
        display: flex; align-items: center; justify-content: center; gap: 0.4rem; width: 100%;
        padding: 0.65rem; border: 1.5px solid var(--rf-red); background: transparent; color: var(--rf-red);
        border-radius: var(--rf-radius-sm); font-size: 0.8rem; font-weight: 700;
        cursor: pointer; transition: all var(--rf-transition); font-family: inherit; margin-bottom: 0.6rem;
    }
    .rf-btn-outline-sm:hover { background: var(--rf-red-light); box-shadow: 0 0 0 3px var(--rf-red-glow); }
    .rf-btn-solid-red {
        display: flex; align-items: center; justify-content: center; width: 100%;
        padding: 0.75rem; background: linear-gradient(135deg, #ef4444, #b91c1c);
        color: #fff; border: none; border-radius: var(--rf-radius-sm);
        font-size: 0.82rem; font-weight: 800; cursor: pointer; transition: all var(--rf-transition);
        font-family: inherit; box-shadow: 0 3px 10px rgba(211,18,18,0.28); margin-bottom: 0.85rem;
    }
    .rf-btn-solid-red:hover { background: linear-gradient(135deg, #dc2626, #991b1b); box-shadow: 0 4px 16px rgba(211,18,18,0.38); }
    .rf-hint-text { font-size: 0.75rem; color: var(--rf-text-muted); text-align: center; line-height: 1.45; }

    /* ── Step Divider ── */
    .rf-step-divider { height: 1px; background: linear-gradient(90deg, transparent, var(--rf-border), transparent); margin: 0.25rem 0 0; }

    /* ── Mobile Warning ── */
    .rf-mobile-warning { display: none; }

    /* ── Responsive ── */
    @media (max-width: 950px) {
        .rf-page-grid { display: flex; flex-direction: column; padding: 0; margin: 0; }
        .rf-left, .rf-right { display: none !important; }
        .rf-main-card { border: none; border-radius: 0; box-shadow: none; }
        .rf-form-hero { padding: 1.2rem 1rem 1rem; }
        .rf-form-title { font-size: 1.25rem; }
        .rf-form-body { padding: 1rem 1rem 1.5rem; gap: 1.4rem; }
        .rf-form-footer { padding: 1rem; flex-direction: column; }
        .rf-btn-cancel { border: none; background: transparent; }
        .rf-two-col { grid-template-columns: 1fr; gap: 1.2rem; }
        .rf-type-grid { grid-template-columns: repeat(3, 1fr); }
        .rf-map-surface { height: 12rem; flex-basis: 12rem; }
        .rf-emergency-bar { font-size: 0.68rem; }
        .rf-mobile-warning {
            display: flex; align-items: center; gap: 0.6rem;
            background: #fffbeb; border: 1px solid #fde68a; border-radius: var(--rf-radius-sm);
            padding: 0.8rem 1rem; margin: 0.9rem 1rem 0;
            font-size: 0.78rem; font-weight: 700; color: #92400e; line-height: 1.4;
        }
        .rf-mobile-warning svg { width: 1.2rem; height: 1.2rem; flex-shrink: 0; }
    }
    @media (min-width: 768px) and (max-width: 950px) {
        .rf-page-grid { max-width: 740px; margin: 1.5rem auto; }
        .rf-main-card { border: 1px solid var(--rf-border); border-radius: var(--rf-radius); box-shadow: var(--rf-card-shadow); }
        .rf-form-hero { padding: 2rem 2rem 1.5rem; }
        .rf-form-body { padding: 1.5rem 2rem 2rem; }
        .rf-form-footer { padding: 1.25rem 2rem; flex-direction: row; }
        .rf-two-col { grid-template-columns: 1fr 1fr; }
        .rf-type-grid { grid-template-columns: repeat(5, 1fr); }
    }
`;

